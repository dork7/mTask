# Copy this file to .env and change the values you need. Every variable the app reads is listed here.
PORT=3000
# The SQLite database file. A relative path starts at the project folder.
DATABASE_PATH=data/app.db
# The folder uploaded photos are stored in. A relative path starts at the project folder.
UPLOADS_DIR=data/uploads
# The Anthropic API key the analyzer sends photos and text with. Without it the rest of the app still runs.
ANTHROPIC_API_KEY=
# The Claude model the analyzer asks. It must read images and take structured outputs.
ANTHROPIC_MODEL=claude-opus-5-5
# The Web Push keys the server signs notifications with. Make them once with
# `npx web-push generate-vapid-keys`. Without all three the app cannot push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

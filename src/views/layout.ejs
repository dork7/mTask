<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= title %> - <%= appName %></title>
  <%- include('partials/theme-script') -%>
  <meta name="theme-color" content="#4f46e5">
  <link rel="manifest" href="/manifest.webmanifest">
  <script>
    if ('serviceWorker' in navigator) {
      navigator.serviceWorker.register("/sw.js");
    }
  </script>
  <link rel="stylesheet" href="/css/base.css">
<% if (locals.miniBar) { -%>
  <script src="/js/timer.js" defer></script>
<% } -%>
<% if (locals.alarm) { -%>
  <script src="/js/alarm.js" defer></script>
<% } -%>
<% if (locals.vapidPublicKey) { -%>
  <meta name="vapid-public-key" content="<%= vapidPublicKey %>">
  <script src="/js/push.js" defer></script>
<% } -%>
</head>
<body>
  <header class="site-header">
    <a href="/"><%= appName %></a>
    <%- include('partials/button', { button: { label: 'Toggle theme', variant: 'ghost', attrs: { 'data-theme-toggle': '' } } }) -%>
  </header>
  <%- include('partials/nav') -%>
  <main class="page">
    <%- include('pages/' + page) %>
  </main>
<% if (locals.miniBar) { -%>
  <%- include('partials/mini-bar', { miniBar: locals.miniBar }) -%>
<% } -%>
<% if (locals.alarm) { -%>
  <%- include('partials/alarm') -%>
<% } -%>
</body>
</html>

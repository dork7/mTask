<%#
  modal: { id, heading, body, actions?, open? }
  `body` and `actions` are HTML built by the caller. The overlay carries the id and is
  hidden unless `open` is true. Opening, closing and focus come with the first job
  that uses a modal.
-%>
<%
  if (typeof modal.id !== 'string' || modal.id === '') throw new Error('modal: id is required');
  if (typeof modal.heading !== 'string' || modal.heading === '') {
    throw new Error('modal: heading is required');
  }
-%>
<div class="overlay overlay--modal" id="<%= modal.id %>"<% if (modal.open !== true) { %> hidden<% } %>>
  <div class="modal" role="dialog" aria-modal="true" aria-labelledby="<%= modal.id %>-title">
    <h2 class="modal__title" id="<%= modal.id %>-title"><%= modal.heading %></h2>
    <div class="modal__body"><%- modal.body %></div>
<% if (modal.actions) { -%>
    <div class="modal__actions"><%- modal.actions %></div>
<% } -%>
  </div>
</div>
